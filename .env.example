# Supabase (required — primary database)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# Groq AI (required — prediction summaries)
GROQ_API_KEY=gsk_your-groq-api-key

# Auth (recommended — keep stable across backend restarts/workers)
AUTH_SECRET=replace-with-a-long-random-secret

# Admin login (required — login is disabled until ADMIN_PASSWORD_HASH is set)
ADMIN_USERNAME=admin
# Create the hash with:
#   python3 -c "from werkzeug.security import generate_password_hash as g; print(g('YOUR-STRONG-PASSWORD', method='pbkdf2:sha256'))"
# Put it in single quotes in .env because it contains '$' characters.
ADMIN_PASSWORD_HASH='replace-with-the-generated-hash'

# Optional: automatically expire past-due units from the dashboard (at most every 6 hours).
# Off by default; the "Run Scan" button on the Alerts page always performs the sweep.
# AUTO_EXPIRY_SWEEP=1
